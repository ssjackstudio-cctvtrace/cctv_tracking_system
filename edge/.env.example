# Copy this file to .env (same folder) and fill in the values.
# Never commit .env to GitHub.

# Supabase → Project Settings → API Keys (use the SECRET key, sb_secret_...)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# edge_device_id returned by supabase/edge_setup.sql PART 2a
EDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000

# Tapo app → Camera → Settings → Advanced Settings → Camera Account
# All cameras use the same Camera Account:
TAPO_USER=your_camera_username
TAPO_PASS=your_camera_password

# Or each camera has its own Camera Account: add one pair per camera.
# The part after TAPO_USER_ / TAPO_PASS_ is the camera_name in Supabase,
# in capital letters with "-" changed to "_"  (e.g. ABT-01 → ABT_01).
# Jackstudio @ Aeon Bukit Tinggi: each camera has its own account, so set all 4
# (passwords are in the AI Edge Box Installation Guide; keep them out of GitHub):
TAPO_USER_ABT_01=Camera01
TAPO_PASS_ABT_01=camera01_password
TAPO_USER_ABT_02=Camera02
TAPO_PASS_ABT_02=camera02_password
TAPO_USER_ABT_03=Camera03
TAPO_PASS_ABT_03=camera03_password
TAPO_USER_ABT_04=Camera04
TAPO_PASS_ABT_04=camera04_password

# AI model: yolo11n.pt on your PC; ./yolo11n_rknn_model on the RK3588 box
MODEL=yolo11n.pt
CONFIDENCE=0.40
IMAGE_SIZE=640
ANCHOR=bottom

# Live picture for the Camera page
SNAPSHOT_SECONDS=5
SNAPSHOT_BUCKET=camera-snapshots

# Full body: a person counts only when their whole body (with feet) is seen.
# Box height / width at least this (lower it if seated / close people are missed)
FULL_BODY_RATIO=1.2

# Same person on all cameras: compare the look of clothes (README → One track ID per person)
# Lower = stricter (fewer mix-ups, but one person may get 2 track IDs). 0.45 is a middle value.
REID_MAX_DISTANCE=0.45
# A visitor no camera has seen for this long is forgotten (left without being counted Out)
VISITOR_FORGET_MINUTES=60
# Cameras with a 3D floor: one person seen by 2 cameras stands within this many metres
SAME_PLACE_METRES=0.9
# Wait this long before making a new visit (another camera may already know the person)
NEW_VISITOR_HOLD_SECONDS=1.0
# Stand in a shop area (Counter / Purchasing ...) this long before it is recorded
REGION_MIN_SECONDS=1.0

# Gender / age (README → Gender and age): looks per visitor, and the optional whole-body model
DEMOGRAPHIC_SAMPLES=8
# BODY_MODEL=models/person_attribute_pa100k.onnx
BODY_WEIGHT=0.6

# Live video for the website (README → Live video). Only sent while someone watches.
# LIVE_PUBLIC_URL = the https address Tailscale Funnel gives the box (starts with https://)
LIVE_PUBLIC_URL=
LIVE_PORT=8090
LIVE_MAX_FPS=15
LIVE_QUALITY=60