# Copy this file to .env (same folder) and fill in the values.
# Never commit .env to GitHub.

# Supabase → Project Settings → API Keys (use the SECRET key, sb_secret_...)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# edge_device_id returned by supabase/edge_setup.sql PART 2a
EDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000

# Tapo app → Camera → Settings → Advanced Settings → Camera Account
# All cameras use the same Camera Account:
TAPO_USER=your_camera_username
TAPO_PASS=your_camera_password

# Or each camera has its own Camera Account: add one pair per camera.
# The part after TAPO_USER_ / TAPO_PASS_ is the camera_name in Supabase,
# in capital letters with "-" changed to "_"  (e.g. ABT-01 → ABT_01).
# Jackstudio @ Aeon Bukit Tinggi: each camera has its own account, so set all 4
# (passwords are in the AI Edge Box Installation Guide; keep them out of GitHub):
TAPO_USER_ABT_01=Camera01
TAPO_PASS_ABT_01=camera01_password
TAPO_USER_ABT_02=Camera02
TAPO_PASS_ABT_02=camera02_password
TAPO_USER_ABT_03=Camera03
TAPO_PASS_ABT_03=camera03_password
TAPO_USER_ABT_04=Camera04
TAPO_PASS_ABT_04=camera04_password

# AI model: yolo11n.pt on your PC; ./yolo11n_rknn_model on the RK3588 box (NPU, ~10x faster).
# On the box, MODEL=yolo11n.pt switches to ./yolo11n_rknn_model by itself when that folder is there
# (MODEL_AUTO_NPU=off keeps the .pt). Check what the box has: python check_models.py
MODEL=yolo11n.pt
# Low on purpose: partly hidden people keep their tracker number; a NEW person still needs a sure
# detection (trackers/bytetrack_cctv.yaml new_track_thresh, and PERSON_CONF_PEAK below)
CONFIDENCE=0.15
IMAGE_SIZE=640
ANCHOR=bottom
# Video decoding: auto = the RK3588's hardware video decoder via the box's ffmpeg (h264_rkmpp /
# hevc_rkmpp) when it has one, else the CPU (OpenCV, e.g. on your PC). off = always the CPU.
# Needed for stream1 (high resolution) on several cameras without lag.
HW_DECODE=auto
# > 0: hand over at most this many pictures per second per camera (0 = all, Tapo sends 15)
DECODE_MAX_FPS=0
# Pictures wider than this are shrunk to it (Tapo stream1 = 2880x1620 -> 1920x1080). 0 = full size.
DECODE_MAX_WIDTH=1920

# Live picture for the Camera page
SNAPSHOT_SECONDS=5
SNAPSHOT_BUCKET=camera-snapshots

# Full body: a person counts only when their whole body (with feet) is seen.
# Box height / width at least this (lower it if seated / close people are missed)
FULL_BODY_RATIO=1.2
# Feet confirmed: a box cut by a table / shelf must not decide where a person stands.
# The body height measured from the box must be at least FOOT_MIN_HEIGHT metres and at least
# FOOT_HEIGHT_SHARE of the height this person had when their feet were seen; otherwise the feet
# are hidden and the person keeps the area they were in.
FOOT_MIN_HEIGHT=1.0
FOOT_HEIGHT_SHARE=0.85

# Same person on all cameras: face + attire + whole body (README → One track ID per person)
# Lower = stricter (fewer mix-ups, but one person may get 2 track IDs). 0.45 is a middle value.
REID_MAX_DISTANCE=0.45
# A person is remembered while any camera sees them, and this many seconds after the last camera
# saw them. Then their track_id ends for good (never given to anyone else); if they never went Out,
# their visit is closed with an Out event. 600 = 10 minutes: a person still inside whom the tracker
# lost (hidden behind a display, out of every camera's picture) gets the SAME track_id back when
# a camera sees them again within 10 minutes with the same look.
TRACK_KEEP_SECONDS=600
# After Passed By / Out (walked out of the shop): the person is still followed but nothing is recorded,
# and their track_id is kept this many seconds after the last camera saw them. Walking back in within
# that time = same visit, same track_id (a new In event).
OUTSIDE_KEEP_SECONDS=300
# Someone first seen OUTSIDE who looks clearly like a visitor seen inside this many seconds ago
# just walked out (the tracker often gives a new number behind the displays at the shop front):
# they keep their track_id and their Out is counted.
EXIT_LINK_SECONDS=8
# Face / whole-body recognition (models from download_models.py). Face: same person above
# REID_FACE_SAME, another person below REID_FACE_DIFFERENT (cosine). Body: the same for REID_BODY_*.
REID_FACE_SAME=0.363
REID_FACE_DIFFERENT=0.20
REID_BODY_SAME=0.60
REID_BODY_DIFFERENT=0.35
# Clothes colours this different (0-1), or heights this many metres apart = another person.
# Only on the SAME camera: across two cameras (other angle / light / calibration) clothes and
# height never say "another person"; only the face, or the whole-body model below
# REID_BODY_DIFFERENT_CROSS (it is lower from another angle), can.
REID_ATTIRE_DIFFERENT=0.70
REID_HEIGHT_DIFFERENT=0.15
REID_BODY_DIFFERENT_CROSS=0.25
# Attire style: the named colour of the top and of the pants (black, grey, white, red, orange,
# yellow, green, cyan, blue, purple, pink). Top OR pants clearly another colour = another person:
# never the same track_id (unless the face is surely the same) and never a Suspicious same person.
# REID_COLOUR_MAIN_SHARE: share of the top / pants the main colour must cover to count.
# REID_COLOUR_OVERLAP (same camera) / _CROSS (two cameras): most colour two parts may share and
# still be "clearly different". REID_ATTIRE_STYLE=off turns this check off.
REID_ATTIRE_STYLE=on
REID_COLOUR_MAIN_SHARE=0.40
REID_COLOUR_OVERLAP=0.30
REID_COLOUR_OVERLAP_CROSS=0.20
# Suspicious same person (Guest): a first track_id only collects later track_ids first seen within
# this many seconds of it (600 = 10 minutes); a later one becomes a new first track_id.
SUSPECT_WINDOW_SECONDS=600
# Suspicious same person is judged by LOOKS only: attire colour + chest and legs texture are needed,
# face, whole body and head texture count when seen. Any of them clearly different = two people.
# SUSPECT_MIN_SCORE: how alike overall (%) to be listed. SUSPECT_MIN_ATTIRE: how alike the attire
# colour must be on its own (%; top and pants judged separately). TEXTURE_DIFFERENT / _CROSS:
# chest / legs pattern difference (0-1) that means another shirt / pants, same camera / two cameras.
SUSPECT_MIN_SCORE=60
SUSPECT_MIN_ATTIRE=55
TEXTURE_DIFFERENT=0.30
TEXTURE_DIFFERENT_CROSS=0.40
# One person seen by the 4 cameras may get a track_id on each camera: a later track_id started up to
# SUSPECT_GAP_SECONDS (another camera) / RETRACK_SECONDS (same camera) after the first was last seen is
# checked, and listed under the EARLIEST first track_id within SUSPECT_GROUP_MARGIN score points.
SUSPECT_GAP_SECONDS=600
RETRACK_SECONDS=600
SUSPECT_GROUP_MARGIN=10
# People per frame whose face + whole body are recognised (each ~0.1-0.2 s on the edge box CPU)
RECOGNIZE_PER_FRAME=1
# Height of every camera above the floor (metres): the 3D floor is made from it
CAMERA_HEIGHT=3.25
# Cameras placed on one shop plan: one person seen by 2 cameras stands within this many metres
SAME_PLACE_METRES=0.9
# ... but with surely the same FACE, up to this far apart is still the same person
# (hand calibration can put one person a little apart on two cameras)
FLOOR_FACE_METRES=2.0
# Wait this long before making a new visit (another camera may already know the person)
NEW_VISITOR_HOLD_SECONDS=1.0
# Overlapping cameras (README → One track ID per person): a person another camera sees right now
# (within OVERLAP_SECONDS), or who went In on another camera within OVERLAP_IN_SECONDS, keeps that
# camera's track_id unless their look is clearly different. OVERLAP_DISTANCE = how loose the look
# match may be for this (0-1; lower = stricter, fewer mix-ups but more duplicate visits).
# 8 s: walking out of one camera's picture into the next can take several seconds.
OVERLAP_SECONDS=8.0
# A person no camera has seen for this long may be given back (same track_id) to someone with a
# matching look who appears inside on any camera (walked out of one picture into the next)
RECLAIM_AFTER_SECONDS=1.0
OVERLAP_IN_SECONDS=4.0
OVERLAP_DISTANCE=0.675
# Stand in a shop area (Counter / Purchasing ...) this long before it is recorded
REGION_MIN_SECONDS=1.0
# Only things that move are people: a new detection must move this share of its own height
# (0.15 ~ 25 cm) before it is followed and counted; not moved after STATIC_SECONDS = an object
# (mannequin, bag stand), ignored. MOVE_CHECK=off turns this off.
MOVE_CHECK=on
MOVE_MIN_SHARE=0.15
STATIC_SECONDS=8
# Things moved BY people (trolley, suitcase) move too: a new detection only becomes a person once
# the detector was this sure at least once, and a box wider on the floor than MAX_BODY_WIDTH
# metres (person + trolley in one box) is not used for areas / looks
PERSON_CONF_PEAK=0.50
MAX_BODY_WIDTH=1.1
# Feet hidden behind a table / the counter / another shopper: floor spot from the head and the
# person's height (AVG_PERSON_HEIGHT behind a saved obstacle when the height is not known yet)
AVG_PERSON_HEIGHT=1.65
# Look for furniture / mannequins every this many seconds for the Floor map (0 = off)
OBSTACLE_SECONDS=30
# Clothes colours: even out the light colour of each person crop before comparing (off = as before)
REID_EVEN_LIGHT=on
# How strongly (0-1). 1 = full gray-world, which also greys out a strongly coloured shirt.
REID_EVEN_LIGHT_STRENGTH=0.5
# Live video: send the picture the AI looked at with its boxes (boxes sit on the people). If the AI
# is more than LIVE_SYNC_MAX_AGE seconds behind, the newest picture is sent without boxes.
LIVE_SYNC=on
LIVE_SYNC_MAX_AGE=1.5
# Cameras on the shop plan: a person lost at one spot can only be someone standing within
# this walking speed (metres per second) x the seconds since, of that spot
PERSON_SPEED_MPS=1.5

# Gender / age (README → Gender and age): looks per visitor, and the optional whole-body model
DEMOGRAPHIC_SAMPLES=8
# BODY_MODEL=models/person_attribute_pa100k.onnx
BODY_WEIGHT=0.6

# Live video for the website (README → Live video). Only sent while someone watches.
# LIVE_PUBLIC_URL = the https address Tailscale Funnel gives the box (starts with https://)
LIVE_PUBLIC_URL=
LIVE_PORT=8090
LIVE_MAX_FPS=15
LIVE_QUALITY=60

# Photo of each track_id for the Camera page "Suspicious same person"
# (private bucket made by supabase/person_photos.sql; folders older than
# PERSON_PHOTO_DAYS are deleted by the box). 0 = no photos.
PERSON_PHOTO_DAYS=7
PERSON_PHOTO_BUCKET=person-photos
PERSON_PHOTO_EVERY_SECONDS=10

# Staff / members recognised by BODY PARTS from any angle (360°), learnt from the biometric
# photos uploaded on the website (README → Staff recognition by body, supabase/biometric_photo.sql).
# Starting values: watch the log with BODY_LOG=on and tune them for your staff and cameras.
BODY_RECOGNITION=on
BIOMETRIC_BUCKET=biometric-photos
BODY_PART_SAME=0.72
BODY_MATCH=0.75
BODY_MARGIN=0.04
BODY_MIN_PARTS=2
BODY_VOTES=3
BODY_VOTE_SHARE=0.6
BODY_EVERY_SECONDS=1.0
BODY_LEARN_SECONDS=2.0
BODY_LIVE_SAMPLES=40
BODY_LEARN_SAME=0.62
# box height / width: standing above BODY_UPRIGHT_RATIO, lying down below BODY_LYING_RATIO
BODY_UPRIGHT_RATIO=1.7
BODY_LYING_RATIO=1.0
BODY_PER_FRAME=1
BODY_RELOAD_SECONDS=120
BODY_ENROL_SECONDS=30
BODY_LOG=off
# A followed person who sits / lies down or crouches and gets a new tracker number on the same spot
POSTURE_RELINK_SECONDS=5.0
POSTURE_OVERLAP=0.4
